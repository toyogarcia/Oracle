{
  "info": {
    "name": "02 - ORDS Productos (tabla Oracle)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "API REST generada con ORDS AutoREST sobre APIDEMO.PRODUCTOS (scripts 11-14). Define ords_base en el entorno."
  },
  "variable": [
    {
      "key": "ords_base",
      "value": "https://TU-HOST.adb.TU-REGION.oraclecloudapps.com/ords/apidemo"
    },
    {
      "key": "producto_id",
      "value": "1"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "client_id",
      "value": ""
    },
    {
      "key": "client_secret",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 - Sin autenticación (script 13)",
      "item": [
        {
          "name": "GET - Lista de productos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{ords_base}}/productos/"
            },
            "description": "",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET - Un producto",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{ords_base}}/productos/{{producto_id}}"
            },
            "description": "",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET - Filtrado: precio > 50",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{ords_base}}/productos/?q={\"precio\":{\"$gt\":50}}"
            },
            "description": "Filtro de ORDS (QBE): parámetro q con JSON",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST - Crear producto",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{ords_base}}/productos/"
            },
            "description": "Guarda el id devuelto en la variable producto_id",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Auriculares Bluetooth\",\n  \"descripcion\": \"Auriculares con cancelación de ruido\",\n  \"precio\": 89.9,\n  \"stock\": 15\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "if (j && j.id) { pm.collectionVariables.set('producto_id', j.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT - Actualizar producto",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{ords_base}}/productos/{{producto_id}}"
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Auriculares Bluetooth PRO\",\n  \"descripcion\": \"Versión actualizada\",\n  \"precio\": 99.9,\n  \"stock\": 20,\n  \"activo\": \"S\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE - Borrar producto",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{ords_base}}/productos/{{producto_id}}"
            },
            "description": "",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2 - Con OAuth2 (script 14)",
      "item": [
        {
          "name": "Obtener token",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{ords_base}}/oauth/token"
            },
            "description": "Intercambia client_id/client_secret por un token (script 14)",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials",
                  "type": "text"
                }
              ]
            },
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{client_id}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{client_secret}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('access_token', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET - Lista de productos (con token)",
